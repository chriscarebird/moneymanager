# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Database — local SQLite file (default for dev, no account needed)
# For production with Turso: TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

# Authentication — passwords for the two app users
USER1_PASSWORD=G$ep6FaYmk?eLq3z
USER2_PASSWORD=DPRgYkk6f?9M7KTM

# Session signing secret (use a long random string)
SESSION_SECRET=P8dTKgnA5Nm#NQMG

# Node environment
NODE_ENV=development

# API port
PORT=3001

# Web Push / VAPID keys — generate once: npx web-push generate-vapid-keys
# Leave unset to disable push notifications (app still works without them).
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@yourdomain.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
