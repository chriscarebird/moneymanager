# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Turso (libsql) Database
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Authentication — passwords for the two app users
USER1_PASSWORD=change-me-user1
USER2_PASSWORD=change-me-user2

# Session signing secret (use a long random string)
SESSION_SECRET=change-me-to-a-very-long-random-secret

# Node environment
NODE_ENV=development

# API port
PORT=3001

# Web Push / VAPID keys — generate once: npx web-push generate-vapid-keys
# Leave unset to disable push notifications (app still works without them).
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@yourdomain.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
