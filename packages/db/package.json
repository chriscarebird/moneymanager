{
  "name": "@investpilot/db",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "migrate": "node --loader ts-node/esm src/migrate.ts",
    "seed": "node --loader ts-node/esm src/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@investpilot/core": "workspace:*",
    "@libsql/client": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
